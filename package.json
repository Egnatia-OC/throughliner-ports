{
  "name": "throughliner-opencode",
  "version": "1.21.1",
  "private": true,
  "description": "Throughliner workflow plugin ported to OpenCode (and Kilo Code). Vendored pristine upstream v1.21.1 + a thin hook-translation plugin.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "esbuild opencode/plugin.ts --bundle --format=esm --platform=node --outfile=.test/plugin.mjs",
    "test": "npm run build && node --test test/harness.mjs"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.18.25",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  }
}
